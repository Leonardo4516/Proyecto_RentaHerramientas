POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=renta_herramientas_db
POSTGRES_PORT=5432

# Configuración Supabase (Cloud PostgreSQL)
SUPABASE_DB_HOST=aws-0-us-east-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.[PROJECT_REF]
SUPABASE_DB_PASSWORD=[YOUR_PASSWORD]
SUPABASE_DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

PGADMIN_DEFAULT_EMAIL=admin@rentatools.com
PGADMIN_DEFAULT_PASSWORD=Admin123456!
PGADMIN_PORT=8082
